/* [공통] 폰트 및 기본 설정 */
* {
    font-family: 'Malgun Gothic', 'Segoe UI', sans-serif;
    font-size: 12px;
    color: #1d1d1f;
}

/* 메인 윈도우 배경 */
QMainWindow {
    background-color: #f5f5f7;
}


QTabWidget::pane {
    border: none;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: transparent;
    padding: 10px 16px;
    margin-right: 15px;
    color: #86868b;
    font-weight: 600;
    font-size: 13px;
}

QTabBar::tab:selected {
    color: #0071e3;
    border-bottom: 2px solid #0071e3;
    background-color: transparent;
}

QTabBar::tab:hover:!selected {
    color: #444;
}


QGroupBox {
    font-weight: 500;
    font-size: 14px;
    color: #0071e3;
    border: none;
    background-color: transparent;
    margin-top: 15px;
    padding-top: 10px;
    padding-left: 0px;
    border-top: 1px solid #cfcfd3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 0 5px 0;
    left: 0px;
}


QLineEdit {
    padding: 5px 10px;
    border: 1px solid #e0e0e5;
    border-radius: 6px;
    background-color: #fbfbfd;
    min-height: 26px;
}

QLineEdit:focus {
    border: 2px solid #0071e3;
    background-color: #ffffff;
}

QLineEdit:hover {
    border-color: #0071e3;
}

/* 라벨 */
QLabel {
    color: #1d1d1f;
    min-height: 26px;
    qproperty-alignment: 'AlignVCenter | AlignLeft';
}

/* 폼 레이아웃 라벨은 조금 더 진하게 */
QFormLayout QLabel {
    color: #3a3a3e;
    font-weight: 500;
}

/* [Button] */
QPushButton {
    padding: 6px 16px;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    background-color: #409cf8;
    color: white;
    font-size: 12px;
    min-height: 24px;
}
QPushButton:hover { background-color: #71b4f7; }
QPushButton:pressed {
    background-color: #4f7194;
    padding-top: 8px;
    padding-bottom: 4px;
}

/* 아이콘 버튼 */
QPushButton[browseButton="true"], QPushButton[secondaryButton="true"] {
    background-color: #f0f0f5;
    color: #1d1d1f;
}
QPushButton[browseButton="true"]:hover {
    background-color: #e5e5ea;
    color: #0071e3;
}

/* 주요 버튼 */
QPushButton[primaryButton="true"] { background-color: #34c759; }
QPushButton[primaryButton="true"]:hover { background-color: #32d75b; }

QPushButton[dangerButton="true"] { background-color: #ff3b30; }
QPushButton[dangerButton="true"]:hover { background-color: #ff4f44; }

QTableWidget {
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    background-color: #ffffff;
    gridline-color: #f2f2f7;
    alternate-background-color: #fbfbfd;
}

QHeaderView::section {
    background-color: #f6f9fc;
    border: none;
    border-bottom: 2px solid #eef2f6;
    border-right: 1px solid #f2f2f7;
    font-weight: 700;
    color: #505055;
    min-height: 32px;
    padding-left: 8px;
}

/* ---------------------------------------------------------
   기타
   --------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #d1d1d6;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background-color: #8e8e93; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QProgressBar {
    border: none;
    background-color: #eff0f5;
    border-radius: 3px;
    height: 10px;
}
QProgressBar::chunk {
    background-color: #0071e3;
    border-radius: 3px;
}

QTextEdit {
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    background-color: #fbfbfd;
    padding: 10px;
    color: #333;
}
QStatusBar {
    background-color: #f9f9fb;
    color: #86868b;
    border-top: 1px solid #ebebeb;
}

/* ---------------------------------------------------------
   사이드바
   --------------------------------------------------------- */
QListWidget {
    background-color: #f2f2f7;
    border: none;
    border-right: 1px solid #d2d2d7;
    outline: none;
    padding-top: 10px;
}

QListWidget::item {
    height: 45px;
    padding-left: 15px;
    color: #555;
    border: none;
    margin-bottom: 2px;
    border-radius: 6px;
    margin-left: 5px;
    margin-right: 5px;
}

QListWidget::item:hover {
    background-color: #eaeaef;
}

QListWidget::item:selected {
    background-color: #e4eef9;
    color: #0071e3;
    font-weight: bold;
}

/* ---------------------------------------------------------
   콤보박스
   --------------------------------------------------------- */
QComboBox {
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 5px 10px;
    background-color: #ffffff;
    min-height: 26px;
    color: #1d1d1f;
}

QComboBox:hover {
    border-color: #b0b0b5;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    margin-right: 5px;
}

/* ---------------------------------------------------------
   QStackedWidget
   --------------------------------------------------------- */
QStackedWidget {
    background-color: #ffffff;
    border-left: 1px solid #e5e5e5;
}

/* ---------------------------------------------------------
   PathInputWidget 라벨
   --------------------------------------------------------- */
QLabel[pathLabel="true"] {
    font-weight: 500;
    min-height: 26px;
}

/* ---------------------------------------------------------
   ProgressWidget 라벨
   --------------------------------------------------------- */
QLabel[percentLabel="true"] {
    color: #555;
    font-size: 12px;
    min-height: 0px;
}

QLabel[statusLabel="true"] {
    color: #888;
    font-size: 11px;
    min-height: 0px;
}

QLabel[detailLabel="true"] {
    color: #aaa;
    font-size: 10px;
    min-height: 0px;
}

/* ---------------------------------------------------------
   SettingsTab 라벨
   --------------------------------------------------------- */
QLabel[hintLabel="true"] {
    color: #666;
    font-size: 11px;
    min-height: 0px;
}

QLabel[aboutLabel="true"] {
    color: #333;
    font-size: 12px;
}

/* ---------------------------------------------------------
   트리 위젯 (쿼리 관리)
   --------------------------------------------------------- */
QTreeWidget {
    border: 1px solid #e8e8ed;
    border-radius: 8px;
    background-color: #ffffff;
    outline: none;
    padding: 4px;
}

QTreeWidget::item {
    height: 32px;
    padding-left: 4px;
    border-radius: 6px;
    margin: 1px 2px;
}

QTreeWidget::item:hover    { background-color: #f0f4f9; }
QTreeWidget::item:selected { background-color: #e4eef9; color: #0071e3; }

/* branch 영역 — 자식 없는 노드는 공간 0, 자식 있는 폴더만 16px 확보 */
QTreeWidget::branch {
    background-color: transparent;
    border-image: none;
    image: none;
    width: 0px;
}
QTreeWidget::branch:has-children:closed,
QTreeWidget::branch:has-children:open {
    width: 16px;
}

/* ---------------------------------------------------------
   메뉴
   --------------------------------------------------------- */
QMenu {
    background-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
    padding: 6px 4px;
}

QMenu::item {
    padding: 7px 20px 7px 12px;
    border-radius: 6px;
    margin: 1px 2px;
    color: #1d1d1f;
}

QMenu::item:selected { background-color: #e4eef9; color: #0071e3; }

QMenu::separator {
    height: 1px;
    background-color: #e8e8ed;
    margin: 4px 8px;
}

/* ---------------------------------------------------------
   체크박스
   --------------------------------------------------------- */
QCheckBox {
    spacing: 8px;
    color: #1d1d1f;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #c8c8cc;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked  { background-color: #0071e3; border-color: #0071e3; }
QCheckBox::indicator:hover    { border-color: #0071e3; }

/* ---------------------------------------------------------
   툴팁
   --------------------------------------------------------- */
QToolTip {
    background-color: #1d1d1f;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ---------------------------------------------------------
   스플리터
   --------------------------------------------------------- */
QSplitter::handle { background-color: #e8e8ed; width: 1px; height: 1px; }
QSplitter::handle:hover { background-color: #0071e3; }

/* ---------------------------------------------------------
   다이얼로그 버튼
   --------------------------------------------------------- */
QDialogButtonBox QPushButton { min-width: 72px; }
